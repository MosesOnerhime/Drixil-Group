# Keep the approved references, durable design decisions and concise QA evidence.
# Derived crops, unselected drafts, browser captures and component experiments
# remain local so routine commits do not import the whole tool workspace.
*
!.gitignore
!config.json
!direction-notes.md
!design.json
!surfaces/
!surfaces/src-app-tsx.md
!approved-group/
!approved-group/a-group.png
!approved-group/a-group.png.json
!mocks/
!mocks/README.md
!mocks/b-interactive.png
!mocks/b-interactive.png.json
!mocks/prompts/
!mocks/prompts/a-group.txt
!mocks/prompts/b-interactive.txt
!build/
!build/regions.json
!build/spec.json
!build/state.json
!archive/
!archive/publisher-2026-10-25/
!archive/publisher-2026-10-25/state.json
!archive/publisher-2026-10-25/README.md
!review/
!review/assets.md
!review/finish-review.md
!review/qa-results.json
!review/accessibility-results.json
!review/performance-results.json
!review/production-results.json
!review/production-browser-results.json
!review/detector-results.json
